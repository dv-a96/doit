#!/usr/bin/env python3
import argparse
import subprocess
import history_manager
from llm_brain import query_llm

def run_shell(command: str, shell: str = "/bin/bash"):
    """
    Executes a bash command, capturing stdout, stderr, and the return code.
    """
    result = subprocess.run(
        command,
        shell=True,
        executable=shell,
        text=True,
        capture_output=True,
        timeout=20,
    )
    return {
        "stdout": result.stdout,
        "stderr": result.stderr,
        "returncode": result.returncode,
    }

def main():
    parser = argparse.ArgumentParser(
        description="Run a natural-language instruction through the AI agent with safety checks and conversation history"
    )
    # Add flag to allow the user to clear the history
    parser.add_argument(
        "--clear", "-c",
        action="store_true",
        help="Clear the conversation history and start fresh"
    )
    parser.add_argument(
        "instruction",
        nargs=argparse.REMAINDER,
        help="Your instruction in natural language",
    )
    args = parser.parse_args()

    # Handle history clearance request
    if args.clear:
        history_manager.clear_history()
        print("🧹 Conversation history cleared.")
        return

    if not args.instruction:
        parser.error("the following arguments are required: instruction or --clear")

    # Join remainder list arguments to construct the full string
    user_instruction = " ".join(args.instruction) if isinstance(args.instruction, list) else args.instruction
    
    # Query LLM (the turn is automatically appended to local history during the query)
    ai_response = query_llm(user_instruction)
    
    action_type = ai_response.get("action_type")
    content = ai_response.get("content", "")
    is_destructive = ai_response.get("is_destructive", False)
    explanation = ai_response.get("explanation", "")
    
    if action_type == "command":
        # Interactive safety guard for destructive actions affecting the filesystem
        if is_destructive:
            print("\n⚠️  [SAFETY WARNING]: This command will modify your system/filesystem!")
            print(f"👉 Proposed Command: {content}")
            print(f"ℹ️  What it does:     {explanation}")
            
            try:
                user_choice = input("Do you want to proceed? [y/N]: ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\nOperation cancelled by user.")
                # Save canceled execution status in history
                history_manager.update_last_turn_execution({
                    "stdout": "",
                    "stderr": "Command cancelled by user.",
                    "returncode": 130
                })
                return
                
            if user_choice != 'y':
                print("Operation cancelled. No changes were made.")
                history_manager.update_last_turn_execution({
                    "stdout": "",
                    "stderr": "Command cancelled by user.",
                    "returncode": 1
                })
                return
        
        # Print the exact command to be executed first
        print(content)
        
        # Execute the final authorized command
        execution_result = run_shell(content)
        
        # Update the saved history turn with the actual terminal execution result
        history_manager.update_last_turn_execution(execution_result)
        
        # Print the output and error if any
        if execution_result["stdout"]:
            print(execution_result["stdout"], end="")
        if execution_result["stderr"]:
            print(f"Error output:\n{execution_result['stderr']}", end="")
            
    elif action_type == "chat":
        # Print a normal assistant chat response
        print(content)
        
    elif action_type == "error":
        print(f"Agent Error: {content}")
        
    else:
        print(f"Unknown action type received: {action_type}")

if __name__ == "__main__":
    main()