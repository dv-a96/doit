#!/usr/bin/env python3
import argparse
import subprocess
from llm_brain import query_llm

def run_shell(command: str, shell: str = "/bin/bash"):
    result = subprocess.run(
        command,
        shell=True,
        executable=shell,
        text=True,
        capture_output=True,
        timeout=20,
    )
    return {
        "stdout": result.stdout,
        "stderr": result.stderr,
        "returncode": result.returncode,
    }

def main():
    parser = argparse.ArgumentParser(
        description="Run a natural-language instruction through the AI agent with safety checks"
    )
    parser.add_argument(
        "instruction",
        nargs=argparse.REMAINDER,
        help="Your instruction in natural language",
    )
    args = parser.parse_args()

    if not args.instruction:
        parser.error("the following arguments are required: instruction")

    user_instruction = args.instruction
    
    # Call the LLM to get the action type, content, and enriched safety details
    ai_response = query_llm(user_instruction)
    
    action_type = ai_response.get("action_type")
    content = ai_response.get("content", "")
    is_destructive = ai_response.get("is_destructive", False)
    explanation = ai_response.get("explanation", "")
    
    # Route based on action type
    if action_type == "command":
        # Interactive safety guard for destructive actions affecting the filesystem
        if is_destructive:
            print("\n⚠️  [SAFETY WARNING]: This command will modify your system/filesystem!")
            print(f"👉 Proposed Command: {content}")
            print(f"ℹ️  What it does:     {explanation}")
            
            try:
                user_choice = input("Do you want to proceed? [y/N]: ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\nOperation cancelled by user.")
                return
                
            if user_choice != 'y':
                print("Operation cancelled. No changes were made.")
                return
        
        # Print the exact command to be executed first
        print(content)
        
        # Execute the final authorized command
        execution_result = run_shell(content)
        
        # Print the output and error if any
        if execution_result["stdout"]:
            print(execution_result["stdout"], end="")
        if execution_result["stderr"]:
            print(f"Error output:\n{execution_result['stderr']}", end="")
            
    elif action_type == "chat":
        # The model is providing a chat response
        print(content)
        
    elif action_type == "error":
        print(f"Agent Error: {content}")
        
    else:
        print(f"Unknown action type received: {action_type}")

if __name__ == "__main__":
    main()