#!/usr/bin/env python3
import argparse
import subprocess
import threading
import history_manager
import memory_agent
from llm_brain import query_llm, handle_self_correction
import os

def run_shell(command: str, shell: str = "/bin/bash"):
    """
    Executes a bash command, capturing stdout, stderr, and the return code.
    """
    result = subprocess.run(
        command,
        shell=True,
        executable=shell,
        text=True,
        capture_output=True,
        timeout=20,
    )
    return {
        "stdout": result.stdout,
        "stderr": result.stderr,
        "returncode": result.returncode,
    }

def main():
    parser = argparse.ArgumentParser(
        description="Run a natural-language instruction through the AI agent with safety checks and conversation history"
    )
    # Add flag to allow the user to clear the history
    parser.add_argument(
        "--clear", "-c",
        action="store_true",
        help="Clear the conversation history and start fresh"
    )
    parser.add_argument(
        "instruction",
        nargs=argparse.REMAINDER,
        help="Your instruction in natural language",
    )
    args = parser.parse_args()

    # Handle history clearance request
    if args.clear:
        history_manager.clear_history()
        print("🧹 Conversation history cleared.")
        return

    if not args.instruction:
        parser.error("the following arguments are required: instruction or --clear")

    # Join remainder list arguments to construct the full string
    user_instruction = " ".join(args.instruction) if isinstance(args.instruction, list) else args.instruction

    # 🧠 Launch background memory agent in a separate non-blocking thread
    memory_thread = threading.Thread(
        target=memory_agent.process_memory_in_background,
        args=(user_instruction,),
        daemon=True
    )
    memory_thread.start()
    
    # Query LLM (the turn is automatically appended to local history during the query)
    ai_response = query_llm(user_instruction)
    
    action_type = ai_response.get("action_type")
    content = ai_response.get("content", "")
    is_destructive = ai_response.get("is_destructive", False)
    explanation = ai_response.get("explanation", "")
    
    if action_type == "command":
        # Interactive safety guard for destructive actions affecting the filesystem
        if is_destructive:
            print("\n⚠️  [SAFETY WARNING]: This command will modify your system/filesystem!")
            print(f"👉 Proposed Command: {content}")
            print(f"ℹ️  What it does:     {explanation}")
            
            try:
                user_choice = input("Do you want to proceed? [y/N]: ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\nOperation cancelled by user.")
                # Save canceled execution status in history
                history_manager.update_last_turn_execution({
                    "stdout": "",
                    "stderr": "Command cancelled by user.",
                    "returncode": 130
                })
                return
                
            if user_choice != 'y':
                print("Operation cancelled. No changes were made.")
                history_manager.update_last_turn_execution({
                    "stdout": "",
                    "stderr": "Command cancelled by user.",
                    "returncode": 1
                })
                return
        
        # Print the exact command to be executed first
        print(content)

        # SPECIAL HANDLING FOR 'cd' COMMANDS:
        if content.strip().startswith("cd ") or content.strip() == "cd":
            raw_path = content.strip()[3:].strip()
            target_dir = os.path.expanduser(raw_path) if raw_path else os.path.expanduser("~")
            
            try:
                os.chdir(target_dir)
                history_manager.update_last_turn_execution({
                    "stdout": f"Changed directory to {os.getcwd()}\n",
                    "stderr": "",
                    "returncode": 0
                })
                
                user_shell = os.environ.get("SHELL", "/bin/bash")
                conda_env = os.environ.get("CONDA_DEFAULT_ENV")
                venv_path = os.environ.get("VIRTUAL_ENV")

                if conda_env and conda_env != "base":
                    import tempfile
                    tmp_rc = tempfile.NamedTemporaryFile("w", delete=False, suffix="_rc")
                    tmp_rc.write(f'source ~/.bashrc 2>/dev/null\nconda activate "{conda_env}" 2>/dev/null\nrm -f "{tmp_rc.name}"\n')
                    tmp_rc.close()
                    os.execl(user_shell, user_shell, "--rcfile", tmp_rc.name, "-i")
                elif venv_path:
                    import tempfile
                    tmp_rc = tempfile.NamedTemporaryFile("w", delete=False, suffix="_rc")
                    tmp_rc.write(f'source ~/.bashrc 2>/dev/null\nsource "{venv_path}/bin/activate" 2>/dev/null\nrm -f "{tmp_rc.name}"\n')
                    tmp_rc.close()
                    os.execl(user_shell, user_shell, "--rcfile", tmp_rc.name, "-i")
                else:
                    os.execl(user_shell, user_shell, "-i")
                
            except Exception as e:
                error_msg = f"cd: {target_dir}: No such file or directory\n"
                print(error_msg, end="")
                history_manager.update_last_turn_execution({
                    "stdout": "",
                    "stderr": error_msg,
                    "returncode": 1
                })
            return
            
        # Execute the primary authorized command
        execution_result = run_shell(content)
        
        # Update the saved history turn with the actual terminal execution result
        history_manager.update_last_turn_execution(execution_result)
        
        # Print output and error if any
        if execution_result["stdout"]:
            print(execution_result["stdout"], end="")
        if execution_result["stderr"]:
            print(f"Error output:\n{execution_result['stderr']}", end="")

        # ---------------------------------------------------------------------
        # 🧠 AUTOMATIC SELF-CORRECTION & ERROR RECOVERY MECHANISM
        # ---------------------------------------------------------------------
        if execution_result["returncode"] != 0 or execution_result["stderr"]:
            correction_res = handle_self_correction(
                failed_command=content,
                stderr=execution_result["stderr"],
                returncode=execution_result["returncode"]
            )
            
            if correction_res and correction_res.get("should_fix"):
                fix_cmd = correction_res.get("fixed_command")
                reason = correction_res.get("explanation")
                
                print(f"\n🔧 [AUTOMATIC SELF-CORRECTION]")
                print(f"❌ Original Command Failed: {content}")
                print(f"💡 Root Cause Analysis:   {reason}")
                print(f"👉 Proposed Fix Command:   {fix_cmd}")
                
                try:
                    user_fix_choice = input("Would you like to execute the suggested fix? [y/N]: ").strip().lower()
                except (KeyboardInterrupt, EOFError):
                    print("\nCorrection cancelled by user.")
                    return
                    
                if user_fix_choice == 'y':
                    print(f"\nRunning fix: {fix_cmd}")
                    fixed_exec_res = run_shell(fix_cmd)
                    
                    if fixed_exec_res["stdout"]:
                        print(fixed_exec_res["stdout"], end="")
                    if fixed_exec_res["stderr"]:
                        print(f"Error output:\n{fixed_exec_res['stderr']}", end="")
                        
                    # Save the self-correction execution output into history
                    history_manager.update_last_turn_execution({
                        "stdout": f"[ORIGINAL FAILED]: {execution_result['stderr']}\n[SELF-CORRECTION APPLIED]: {fixed_exec_res['stdout']}",
                        "stderr": fixed_exec_res["stderr"],
                        "returncode": fixed_exec_res["returncode"]
                    })
            
    elif action_type == "chat":
        print(content)
        
    elif action_type == "error":
        print(f"Agent Error: {content}")
        
    else:
        print(f"Unknown action type received: {action_type}")

if __name__ == "__main__":
    main()